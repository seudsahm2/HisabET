rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function claimPath(phone) {
      return /databases/$(database)/documents/phone_claims/$(phone);
    }

    // ── Phone identity ──────────────────────────────────────────────────────
    // `phone` is what other users search for and reconcile ledgers against, so
    // it must be proven and unique. Clients may change these fields only with
    // proof from Firebase Auth (SMS code / phone sign-in) plus a matching
    // phone_claims document in the same batch. Telegram-verified numbers are
    // written by the backend (functions/), which these rules do not apply to.
    // Design: TELEGRAM_PHONE_VERIFICATION.md.

    function phoneIdentityKeys() {
      return ['phone', 'phoneVerified', 'phoneVerificationMethod', 'phoneVerifiedAt'];
    }

    function phoneIdentityUnchanged() {
      return resource == null
        ? !request.resource.data.keys().hasAny(phoneIdentityKeys())
        : !request.resource.data.diff(resource.data).affectedKeys().hasAny(phoneIdentityKeys());
    }

    function provenByFirebaseAuth(uid) {
      let d = request.resource.data;
      return d.get('phone', null) is string
        && d.phone == request.auth.token.get('phone_number', '')
        && d.get('phoneVerified', false) == true
        && d.get('phoneVerificationMethod', '') in ['auth', 'otp']
        && existsAfter(claimPath(d.phone))
        && getAfter(claimPath(d.phone)).data.uid == uid;
    }

    // True when the caller holds [phone]'s claim, i.e. it is their verified number.
    function holdsPhone(phone) {
      return signedIn()
        && phone is string
        && exists(claimPath(phone))
        && get(claimPath(phone)).data.uid == request.auth.uid;
    }

    // 1. USERS COLLECTION
    match /users/{userId} {
      // Any authenticated user can read profiles (global search, anti-cycle check)
      allow read: if signedIn();
      // Owner writes their own profile; phone identity fields need proof.
      allow create, update: if isUser(userId)
        && (phoneIdentityUnchanged() || provenByFirebaseAuth(userId));
      allow delete: if isUser(userId);
    }

    // 1a. PHONE CLAIMS — the uniqueness index. Document id = E.164 number,
    // so a second account can never create a claim for a held number.
    match /phone_claims/{phone} {
      // You may check a number you hold, or that a number is free. Nobody can
      // list who holds which number.
      allow get: if signedIn()
        && (resource == null || resource.data.uid == request.auth.uid);
      allow list: if false;
      // Firebase Auth path only, written in the same batch as users.phone.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'method', 'claimedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.method in ['auth', 'otp']
        && request.resource.data.claimedAt == request.time
        && phone == request.auth.token.get('phone_number', '')
        && getAfter(userPath(request.auth.uid)).data.get('phone', '') == phone;
      allow update: if false;
      // Release a number you hold once your profile no longer uses it.
      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid
        && (!existsAfter(userPath(request.auth.uid))
            || getAfter(userPath(request.auth.uid)).data.get('phone', '') != phone);
    }

    // 1b. PHONE VERIFICATION SESSIONS (Telegram). The app creates a pending
    // session with an unguessable id; only the backend moves it forward.
    match /phone_verifications/{sessionId} {
      allow get: if signedIn() && resource.data.uid == request.auth.uid;
      allow list: if false;
      allow create: if signedIn()
        && sessionId.matches('^[A-Za-z0-9_-]{32,64}$')
        && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // telegram_links/{telegramUserId} is backend-only: covered by DEFAULT DENY.

    // 2. CONNECTION REQUESTS
    match /connection_requests/{requestId} {
      allow create: if request.auth != null && request.resource.data.fromUid == request.auth.uid;
      allow read, update, delete: if request.auth != null && 
        (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // 3. TRANSACTIONS (Specific User Ledgers)
    match /users/{userId}/transactions/{transactionId} {
      // The owner of the ledger can do everything
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // A contact can read the transaction if their UID is explicitly attached to it
      allow read: if request.auth != null && resource.data.contact_uid == request.auth.uid;

      // A contact can read the transaction if it names THEIR number. "Theirs"
      // means they hold its phone_claims document — unforgeable, unlike the
      // old check (any signed-in user could read any entry with a phone).
      allow read: if holdsPhone(resource.data.contact_phone);
    }

    // 4. TRANSACTIONS (Collection Group queries across all users)
    match /{path=**}/transactions/{transactionId} {
      allow read: if request.auth != null && resource.data.contact_uid == request.auth.uid;
      allow read: if holdsPhone(resource.data.contact_phone);
    }
    
    // 4b. TENDERS — the B2B board. A supplier posts; brokers compete to win.
    // Both sides must have a verified phone, so every tender and every win
    // is tied to a real, unique trader.
    function hasVerifiedPhone(uid) {
      return get(userPath(uid)).data.get('phoneVerified', false) == true;
    }

    function isSupplier(uid) {
      // Raw strings because rules cannot call BusinessRole: lowercase keys
      // plus the legacy capitalised / 'importer' values it still accepts.
      return get(userPath(uid)).data.get('roles', [])
        .hasAny(['supplier', 'Supplier', 'importer', 'Importer']);
    }

    function validNewTender() {
      let d = request.resource.data;
      return d.keys().hasOnly(['importerUid', 'importerName', 'itemNumber', 'cartons',
                               'seriesSize', 'price', 'status', 'createdAt',
                               'photoUrl', 'colorDistribution'])
        && d.importerUid == request.auth.uid
        && d.status == 'open'
        && d.createdAt == request.time
        && d.importerName is string && d.importerName.size() <= 120
        && d.itemNumber is string && d.itemNumber.size() > 0 && d.itemNumber.size() <= 64
        && d.cartons is int && d.cartons > 0 && d.cartons <= 100000
        && d.seriesSize is int && d.seriesSize > 0 && d.seriesSize <= 100
        && d.price is number && d.price > 0;
    }

    match /tenders/{tenderId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && validNewTender()
        && isSupplier(request.auth.uid)
        && hasVerifiedPhone(request.auth.uid);
      // Claim an open tender. Rules see the committed state, so of two
      // brokers racing, the second finds status == 'won' and is refused.
      allow update: if signedIn()
        && resource.data.status == 'open'
        && resource.data.importerUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'winnerUid', 'wonAt'])
        && request.resource.data.status == 'won'
        && request.resource.data.winnerUid == request.auth.uid
        && request.resource.data.wonAt == request.time
        && hasVerifiedPhone(request.auth.uid);
      // The supplier may withdraw a tender nobody has won yet.
      allow delete: if isUser(resource.data.importerUid)
        && resource.data.status == 'open';
    }

    // 5. DEFAULT DENY
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
